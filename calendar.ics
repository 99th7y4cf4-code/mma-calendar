import json
import re
import unicodedata
from datetime import datetime, date
from urllib.parse import quote

import requests
from bs4 import BeautifulSoup
from icalendar import Calendar, Event


# ============================================================
# CONFIGURATION
# ============================================================

FIGHTERS_FILE = "combattants.json"
OUTPUT_FILE = "calendar.ics"

NEXT_FIGHT_URL = "https://next-fight.com/en/fighter/{}"

HEADERS = {
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
        "AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/139 Safari/537.36"
    )
}

# Les organisations que nous voulons suivre.
ALLOWED_ORGANIZATIONS = {
    "ufc": "UFC",
    "pfl": "PFL",
    "one championship": "ONE Championship",
    "one fc": "ONE Championship",
    "ksw": "KSW",
    "ares": "ARES",
    "aca": "ACA",
    "brave cf": "BRAVE CF",
    "rizin": "RIZIN",
    "bellator": "Bellator",
    "pfl mena": "PFL",
    "pfl africa": "PFL",
}

# Alias utiles pour certains noms.
FIGHTER_ALIASES = {
    "Baysangur “Baki” Chamsoudinov": [
        "baysangur chamsoudinov",
        "baki chamsoudinov",
    ],
    "Benoît Saint Denis": [
        "benoit saint denis",
        "benn saint denis",
    ],
}


# ============================================================
# OUTILS
# ============================================================

def normalize(text):
    if not text:
        return ""

    text = unicodedata.normalize("NFD", text)

    text = "".join(
        char
        for char in text
        if unicodedata.category(char) != "Mn"
    )

    text = text.lower()

    text = re.sub(
        r"[^a-z0-9]+",
        " ",
        text
    )

    return " ".join(text.split())


def slugify(name):
    """
    Transforme un nom en slug Next-Fight.
    """

    normalized = normalize(name)

    return normalized.replace(" ", "-")


def load_fighters():
    with open(
        FIGHTERS_FILE,
        "r",
        encoding="utf-8"
    ) as file:
        data = json.load(file)

    fighters = []

    for category in ("mma", "judo"):
        for fighter in data.get(category, []):
            if fighter not in fighters:
                fighters.append(fighter)

    return fighters


def get_aliases(fighter):
    aliases = [fighter]

    aliases.extend(
        FIGHTER_ALIASES.get(
            fighter,
            []
        )
    )

    return aliases


def fighter_in_text(text, fighter):
    normalized_text = normalize(text)

    for alias in get_aliases(fighter):
        if normalize(alias) in normalized_text:
            return True

    return False


def download(url):
    response = requests.get(
        url,
        headers=HEADERS,
        timeout=30
    )

    response.raise_for_status()

    return response


def parse_date(text):
    if not text:
        return None

    text = text.strip()

    formats = [
        "%B %d, %Y",
        "%b %d, %Y",
        "%d %B %Y",
        "%d %b %Y",
        "%Y-%m-%d",
    ]

    for fmt in formats:
        try:
            return datetime.strptime(
                text,
                fmt
            )
        except ValueError:
            pass

    # Recherche d'une date dans un texte plus long.
    patterns = [
        r"(January|February|March|April|May|June|July|August|"
        r"September|October|November|December)\s+"
        r"(\d{1,2}),\s+(\d{4})",

        r"(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s+"
        r"(\d{1,2}),\s+(\d{4})",
    ]

    for pattern in patterns:
        match = re.search(
            pattern,
            text,
            re.IGNORECASE
        )

        if match:
            try:
                return datetime.strptime(
                    match.group(0),
                    "%B %d, %Y"
                )
            except ValueError:
                try:
                    return datetime.strptime(
                        match.group(0),
                        "%b %d, %Y"
                    )
                except ValueError:
                    pass

    return None


def detect_organization(text):
    normalized = normalize(text)

    # On teste les organisations les plus précises
    # avant les noms génériques.
    tests = [
        ("one championship", "ONE Championship"),
        ("one fc", "ONE Championship"),
        ("pfl africa", "PFL"),
        ("pfl mena", "PFL"),
        ("pfl", "PFL"),
        ("ufc", "UFC"),
        ("ksw", "KSW"),
        ("ares", "ARES"),
        ("aca", "ACA"),
        ("brave cf", "BRAVE CF"),
        ("rizin", "RIZIN"),
        ("bellator", "Bellator"),
    ]

    for keyword, organization in tests:
        if normalize(keyword) in normalized:
            return organization

    return None


# ============================================================
# CALENDRIER
# ============================================================

def create_calendar():

    calendar = Calendar()

    calendar.add(
        "prodid",
        "-//Mon Calendrier MMA et Judo//FR"
    )

    calendar.add(
        "version",
        "2.0"
    )

    calendar.add(
        "X-WR-CALNAME",
        "Mes Combats MMA & Judo"
    )

    calendar.add(
        "X-WR-CALDESC",
        "Combats et compétitions de mes sportifs préférés"
    )

    calendar.add(
        "X-WR-TIMEZONE",
        "Europe/Paris"
    )

    return calendar


# ============================================================
# AJOUT D'UN COMBAT
# ============================================================

def add_fight(
    calendar,
    fighter,
    opponent,
    organization,
    event_name,
    event_date,
    url,
    uid_suffix
):

    event = Event()

    event.add(
        "uid",
        "mma-calendar-" + uid_suffix
    )

    event.add(
        "summary",
        f"🥊 {organization} — {fighter} vs {opponent}"
    )

    event.add(
        "dtstart",
        event_date
    )

    event.add(
        "description",
        "\n".join(
            [
                "⭐ COMBATTANT SUIVI",
                fighter,
                "",
                f"🥊 Adversaire : {opponent}",
                "",
                f"Organisation : {organization}",
                "",
                f"Événement : {event_name}",
                "",
                "Source :",
                url,
            ]
        )
    )

    event.add(
        "url",
        url
    )

    event.add(
        "categories",
        f"MMA,{organization}"
    )

    calendar.add_component(
        event
    )


# ============================================================
# RECHERCHE DU PROCHAIN COMBAT D'UN COMBATTANT
# ============================================================

def find_next_fight(
    fighter
):

    slug = slugify(fighter)

    url = NEXT_FIGHT_URL.format(
        quote(slug)
    )

    try:
        response = download(
            url
        )
    except Exception as error:
        print(
            f"⚠️ {fighter} : impossible d'accéder à la fiche"
        )
        print(error)
        return None

    soup = BeautifulSoup(
        response.text,
        "html.parser"
    )

    text = soup.get_text(
        " ",
        strip=True
    )

    if not fighter_in_text(
        text,
        fighter
    ):
        return None

    # --------------------------------------------------------
    # ORGANISATION
    # --------------------------------------------------------

    organization = detect_organization(
        text
    )

    if not organization:
        return None

    # --------------------------------------------------------
    # DATE
    # --------------------------------------------------------

    # On cherche d'abord autour de la zone
    # "Next Fight".
    next_fight_text = text

    marker = re.search(
        r"Next Fight(.*?)(?:Tech sheet|Key Stats|Last fight)",
        text,
        re.IGNORECASE
    )

    if marker:
        next_fight_text = marker.group(1)

    event_date = parse_date(
        next_fight_text
    )

    if not event_date:
        return None

    if event_date.date() < date.today():
        return None

    # --------------------------------------------------------
    # ÉVÉNEMENT / ADVERSAIRE
    # --------------------------------------------------------

    event_name = "Combat annoncé"

    opponent = "Adversaire à confirmer"

    # Tentative de récupération du titre
    title = soup.title

    if title:
        title_text = title.get_text(
            " ",
            strip=True
        )

        if title_text:
            event_name = title_text

    # Recherche de "vs"
    vs_match = re.search(
        r"([A-Za-zÀ-ÿ'’.\- ]+)"
        r"\s+(?:vs\.?|versus)"
        r"\s+"
        r"([A-Za-zÀ-ÿ'’.\- ]+)",
        next_fight_text,
        re.IGNORECASE
    )

    if vs_match:
        first = vs_match.group(1).strip()
        second = vs_match.group(2).strip()

        # Si le premier nom est le combattant suivi,
        # l'autre est l'adversaire.
        if normalize(fighter) in normalize(first):
            opponent = second
        else:
            opponent = first

    return {
        "fighter": fighter,
        "opponent": opponent,
        "organization": organization,
        "event_name": event_name,
        "date": event_date,
        "url": url,
    }


# ============================================================
# JUDO
# ============================================================

IJF_ATHLETES = {
    "Teddy Riner": "https://www.ijf.org/athlete/385",
    "Joan-Benjamin Gaba": "https://www.ijf.org/athlete/46709",
}


def add_judo(
    calendar,
    fighters
):

    count = 0

    print()
    print("==============================")
    print("🥋 JUDO")
    print("==============================")

    for fighter, url in IJF_ATHLETES.items():

        if fighter not in fighters:
            continue

        try:
            response = download(
                url
            )
        except Exception as error:
            print(
                f"⚠️ {fighter} : erreur IJF"
            )
            print(error)
            continue

        soup = BeautifulSoup(
            response.text,
            "html.parser"
        )

        text = soup.get_text(
            " ",
            strip=True
        )

        # On ne crée pas de faux événement :
        # si aucune compétition future identifiable
        # n'est trouvée, on ne met rien.
        dates = re.findall(
            r"(?:January|February|March|April|May|June|July|"
            r"August|September|October|November|December)"
            r"\s+\d{1,2},\s+\d{4}",
            text,
            re.IGNORECASE
        )

        seen = set()

        for date_text in dates:

            competition_date = parse_date(
                date_text
            )

            if not competition_date:
                continue

            if competition_date.date() < date.today():
                continue

            # Cherche le texte autour de la date.
            position = text.find(
                date_text
            )

            start = max(
                0,
                position - 180
            )

            end = min(
                len(text),
                position + 180
            )

            competition_name = text[
                start:end
            ].strip()

            key = (
                fighter,
                competition_date.date(),
                competition_name
            )

            if key in seen:
                continue

            seen.add(
                key
            )

            event = Event()

            event.add(
                "uid",
                (
                    "judo-calendar-"
                    + slugify(fighter)
                    + "-"
                    + competition_date.strftime(
                        "%Y%m%d"
                    )
                )
            )

            event.add(
                "summary",
                f"🥋 Judo — {fighter}"
            )

            event.add(
                "dtstart",
                competition_date
            )

            event.add(
                "description",
                "\n".join(
                    [
                        "⭐ JUDOKA SUIVI",
                        fighter,
                        "",
                        "Compétition internationale",
                        "",
                        "Source officielle IJF :",
                        url,
                    ]
                )
            )

            event.add(
                "url",
                url
            )

            event.add(
                "categories",
                "Judo,IJF"
            )

            calendar.add_component(
                event
            )

            count += 1

            print(
                "✓",
                fighter,
                competition_date.date()
            )

    return count


# ============================================================
# PROGRAMME PRINCIPAL
# ============================================================

def main():

    print()
    print("==========================================")
    print("   CALENDRIER MMA + JUDO")
    print("==========================================")

    fighters = load_fighters()

    print()
    print("Combattants surveillés :")

    for fighter in fighters:
        print(
            " -",
            fighter
        )

    calendar = create_calendar()

    mma_count = 0

    # --------------------------------------------------------
    # MMA
    # --------------------------------------------------------

    print()
    print("==============================")
    print("🥊 MMA")
    print("==============================")

    for fighter in fighters:

        # Les deux judokas ne sont pas recherchés
        # comme combattants MMA.
        if fighter in (
            "Teddy Riner",
            "Joan-Benjamin Gaba"
        ):
            continue

        print()
        print(
            "Recherche :",
            fighter
        )

        result = find_next_fight(
            fighter
        )

        if not result:
            print(
                "  Aucun combat futur détecté."
            )
            continue

        add_fight(
            calendar=calendar,
            fighter=result["fighter"],
            opponent=result["opponent"],
            organization=result["organization"],
            event_name=result["event_name"],
            event_date=result["date"],
            url=result["url"],
            uid_suffix=(
                slugify(result["fighter"])
                + "-"
                + result["date"].strftime(
                    "%Y%m%d"
                )
            )
        )

        mma_count += 1

        print(
            "  ✓",
            result["organization"],
            "-",
            result["date"].date()
        )

    # --------------------------------------------------------
    # JUDO
    # --------------------------------------------------------

    judo_count = add_judo(
        calendar,
        fighters
    )

    # --------------------------------------------------------
    # SAUVEGARDE
    # --------------------------------------------------------

    with open(
        OUTPUT_FILE,
        "wb"
    ) as file:

        file.write(
            calendar.to_ical()
        )

    print()
    print("==========================================")
    print("              TERMINÉ")
    print("==========================================")
    print(
        f"MMA : {mma_count}"
    )
    print(
        f"Judo : {judo_count}"
    )
    print(
        f"TOTAL : {mma_count + judo_count}"
    )
    print()
    print(
        "calendar.ics créé avec succès."
    )


if __name__ == "__main__":
    main()
